{
  "name": "otolabo-passerelle",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "otolabo-passerelle",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/gateway": {
      "name": "@otolabo/gateway",
      "version": "0.1.0",
      "dependencies": {
        "@otolabo/shared": "*"
      }
    },
    "node_modules/@otolabo/gateway": {
      "resolved": "apps/gateway",
      "link": true
    },
    "node_modules/@otolabo/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/shared": {
      "name": "@otolabo/shared",
      "version": "0.1.0"
    }
  }
}
